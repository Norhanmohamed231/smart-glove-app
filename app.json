{
  "expo": {
    "name": "SignBridge",
    "slug": "signbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "signbridge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "SignBridge connects to the smart glove via Bluetooth to receive sensor data.",
        "NSMicrophoneUsageDescription": "SignBridge needs microphone access for speech-to-text.",
        "NSSpeechRecognitionUsageDescription": "SignBridge needs speech recognition to convert your voice to text."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.signbridge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "onnxruntime-react-native",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SignBridge needs microphone access for speech-to-text.",
          "speechRecognitionPermission": "SignBridge needs speech recognition to convert your voice to text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070814",
          "dark": {
            "backgroundColor": "#070814"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfd51360-a5fb-4419-8c92-35885fadd587"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png"
    }
  }
}